{
  "name": "BudgetWorksheet",
  "type": "object",
  "properties": {
    "fiscal_year": {
      "type": "string",
      "description": "e.g. FY2027"
    },
    "department": {
      "type": "string"
    },
    "fund": {
      "type": "string",
      "enum": [
        "general_fund",
        "school",
        "county",
        "enterprise",
        "tif",
        "debt_service",
        "capital_reserve"
      ],
      "default": "general_fund"
    },
    "account_code": {
      "type": "string"
    },
    "account_name": {
      "type": "string"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "appropriation",
        "revenue",
        "deduction",
        "transfer",
        "tif",
        "enterprise_offset",
        "overlay"
      ]
    },
    "article_number": {
      "type": "string",
      "description": "Warrant article reference"
    },
    "prior_year_actual": {
      "type": "number"
    },
    "prior_year_budget": {
      "type": "number"
    },
    "manager_request": {
      "type": "number"
    },
    "budget_committee": {
      "type": "number"
    },
    "select_board": {
      "type": "number"
    },
    "adopted": {
      "type": "number"
    },
    "revised_budget": {
      "type": "number"
    },
    "ytd_actual": {
      "type": "number"
    },
    "projected_year_end": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "is_locked": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "fiscal_year",
    "fund",
    "account_type",
    "account_name"
  ]
}