{
  "name": "OrgPosition",
  "type": "object",
  "properties": {
    "position_id": {
      "type": "string",
      "description": "Unique stable identifier (e.g. 'finance_director')"
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string",
      "description": "Secondary title or role (e.g. 'Deputy Treasurer')"
    },
    "department": {
      "type": "string"
    },
    "division": {
      "type": "string"
    },
    "level": {
      "type": "number",
      "description": "Org level 1-8"
    },
    "reports_to": {
      "type": "string",
      "description": "position_id of direct supervisor"
    },
    "reports_to_alt": {
      "type": "string",
      "description": "Alternate supervisor position_id for scenario modeling"
    },
    "employment_type": {
      "type": "string",
      "enum": [
        "full_time",
        "part_time",
        "stipend",
        "elected",
        "appointed",
        "contracted",
        "volunteer"
      ],
      "default": "full_time"
    },
    "status": {
      "type": "string",
      "enum": [
        "filled",
        "vacant",
        "proposed",
        "eliminated",
        "frozen"
      ],
      "default": "vacant"
    },
    "fund_source": {
      "type": "string",
      "enum": [
        "general_fund",
        "ambulance_fund",
        "sewer_fund",
        "transfer_station",
        "airport",
        "school",
        "enterprise",
        "regional_revenue",
        "grant"
      ],
      "default": "general_fund"
    },
    "base_salary": {
      "type": "number"
    },
    "is_union": {
      "type": "boolean",
      "default": false
    },
    "is_configurable": {
      "type": "boolean",
      "default": false,
      "description": "Can be toggled by scenario settings"
    },
    "scenario_tags": {
      "type": "string",
      "description": "Comma-separated scenario names this position appears in"
    },
    "account_code": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "visible_in_chart": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "position_id",
    "title",
    "department"
  ]
}