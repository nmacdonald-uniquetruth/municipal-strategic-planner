{
  "name": "COACrosswalkVersion",
  "type": "object",
  "properties": {
    "version_label": {
      "type": "string",
      "description": "Human-readable version label, e.g. v1.0-draft, v2.0-approved"
    },
    "fiscal_year": {
      "type": "string",
      "description": "Effective fiscal year, e.g. FY2027"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "under_review",
        "approved",
        "superseded",
        "archived"
      ],
      "default": "draft",
      "description": "Approval workflow status"
    },
    "source_file_name": {
      "type": "string",
      "description": "Original uploaded workbook filename"
    },
    "source_file_url": {
      "type": "string",
      "description": "URL to the uploaded source file"
    },
    "upload_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the source file was uploaded"
    },
    "uploaded_by": {
      "type": "string",
      "description": "User email who uploaded"
    },
    "account_count": {
      "type": "number",
      "default": 0,
      "description": "Number of accounts in this version"
    },
    "mapped_count": {
      "type": "number",
      "default": 0
    },
    "unmapped_count": {
      "type": "number",
      "default": 0
    },
    "exception_count": {
      "type": "number",
      "default": 0
    },
    "approved_by": {
      "type": "string",
      "description": "User who approved this version"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "review_notes": {
      "type": "string",
      "description": "Notes from reviewer / approver"
    },
    "is_active": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is the currently active version"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "version_label",
    "fiscal_year"
  ]
}