{
  "name": "WarrantArticle",
  "type": "object",
  "properties": {
    "fiscal_year": {
      "type": "string",
      "description": "e.g. FY2027"
    },
    "article_number": {
      "type": "string",
      "description": "e.g. Article 4"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "title": {
      "type": "string",
      "description": "Short article title for index"
    },
    "category": {
      "type": "string",
      "enum": [
        "municipal_appropriation",
        "school_appropriation",
        "county_assessment",
        "revenue",
        "tif",
        "fund_balance_transfer",
        "enterprise_appropriation",
        "policy_authorization",
        "capital",
        "debt_authorization",
        "other"
      ]
    },
    "legal_type": {
      "type": "string",
      "enum": [
        "appropriation",
        "authorization",
        "transfer",
        "assessment",
        "information",
        "other"
      ],
      "default": "appropriation"
    },
    "voting_method": {
      "type": "string",
      "enum": [
        "majority_voice",
        "majority_written",
        "secret_ballot",
        "two_thirds",
        "three_fifths",
        "majority_raise_hands",
        "n_a"
      ],
      "default": "majority_voice"
    },
    "draft_text": {
      "type": "string",
      "description": "Full warrant article text"
    },
    "board_text": {
      "type": "string",
      "description": "Select Board presentation version"
    },
    "public_text": {
      "type": "string",
      "description": "Plain-language public summary"
    },
    "financial_amount": {
      "type": "number",
      "description": "Dollar amount for this article"
    },
    "prior_year_amount": {
      "type": "number"
    },
    "linked_budget_lines": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "account_codes or identifiers from BudgetWorksheet"
    },
    "linked_deductions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bete_mapping": {
      "type": "string",
      "description": "Which BETE form line this maps to"
    },
    "tax_impact_note": {
      "type": "string"
    },
    "explanatory_notes": {
      "type": "string"
    },
    "legal_review_status": {
      "type": "string",
      "enum": [
        "not_reviewed",
        "under_review",
        "approved",
        "requires_revision"
      ],
      "default": "not_reviewed"
    },
    "text_frozen": {
      "type": "boolean",
      "default": false,
      "description": "When true, draft_text is locked; financial calcs still refresh"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "proposed",
        "board_approved",
        "posted",
        "adopted",
        "amended",
        "failed"
      ],
      "default": "draft"
    },
    "warrant_id": {
      "type": "string",
      "description": "Parent warrant/fiscal year grouping key"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "fiscal_year",
    "article_number",
    "title",
    "category"
  ]
}