{
  "name": "DepartmentBudget",
  "type": "object",
  "properties": {
    "process_id": {
      "type": "string",
      "description": "Parent BudgetProcess id"
    },
    "fiscal_year": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "fund": {
      "type": "string",
      "enum": [
        "general_fund",
        "school",
        "county",
        "enterprise",
        "tif",
        "debt_service",
        "capital_reserve",
        "special_revenue"
      ],
      "default": "general_fund"
    },
    "fund_type": {
      "type": "string",
      "enum": [
        "governmental",
        "enterprise",
        "special_revenue",
        "debt_service"
      ],
      "default": "governmental"
    },
    "article_number": {
      "type": "string",
      "description": "Warrant article this dept maps to"
    },
    "bete_mapping": {
      "type": "string",
      "description": "BETE form line (e.g. municipalAppropriations)"
    },
    "prior_year_budget": {
      "type": "number"
    },
    "prior_year_actual": {
      "type": "number"
    },
    "current_year_budget": {
      "type": "number"
    },
    "ytd_actual": {
      "type": "number"
    },
    "projected_year_end": {
      "type": "number"
    },
    "dept_request": {
      "type": "number",
      "description": "Department's requested next-year budget"
    },
    "finance_recommendation": {
      "type": "number"
    },
    "manager_recommendation": {
      "type": "number"
    },
    "budget_committee_recommendation": {
      "type": "number"
    },
    "select_board_recommendation": {
      "type": "number"
    },
    "adopted_budget": {
      "type": "number"
    },
    "revised_budget": {
      "type": "number",
      "description": "Post-adoption revisions"
    },
    "carryforward_amount": {
      "type": "number",
      "default": 0
    },
    "enterprise_transfer": {
      "type": "number",
      "default": 0,
      "description": "Enterprise fund offset contribution"
    },
    "justification_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "contractual",
          "statutory",
          "inflationary",
          "service_expansion",
          "capital_need",
          "staffing",
          "emergency_risk",
          "grant_match",
          "one_time",
          "recurring"
        ]
      }
    },
    "justification_narrative": {
      "type": "string"
    },
    "manager_notes": {
      "type": "string"
    },
    "budget_committee_notes": {
      "type": "string"
    },
    "select_board_notes": {
      "type": "string"
    },
    "manager_approved": {
      "type": "boolean",
      "default": false
    },
    "budget_committee_approved": {
      "type": "boolean",
      "default": false
    },
    "select_board_approved": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "fiscal_year",
    "department",
    "fund"
  ]
}