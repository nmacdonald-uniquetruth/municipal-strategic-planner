      "default": 0.03
    },
    "stipend_elimination": {
      "type": "number",
      "default": 26000
    },
    "airport_savings": {
      "type": "number",
      "default": 2527
    },
    "control_risk_exposure": {
      "type": "number",
      "default": 56000
