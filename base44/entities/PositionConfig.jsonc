{
  "name": "PositionConfig",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "phase1",
        "trigger_based",
        "proposed",
        "eliminated"
      ],
      "default": "phase1"
    },
    "base_salary": {
      "type": "number"
    },
    "is_stipend": {
      "type": "boolean",
      "default": false
    },
    "hire_month_offset": {
      "type": "number",
      "description": "Months from project start date",
      "default": 1
    },
    "partial_year_months_y1": {
      "type": "number",
      "description": "How many months in Year 1",
      "default": 12
    },
    "fund_source": {
      "type": "string",
      "enum": [
        "general_fund",
        "ambulance_fund",
        "airport_budget",
        "regional_revenue",
        "enterprise_fund"
      ],
      "default": "general_fund"
    },
    "health_tier": {
      "type": "string",
      "enum": [
        "individual",
        "employee_spouse",
        "employee_children",
        "family",
        "none"
      ],
      "default": "family"
    },
    "include_fica": {
      "type": "boolean",
      "default": true
    },
    "include_pers": {
      "type": "boolean",
      "default": true
    },
    "include_wc": {
      "type": "boolean",
      "default": true
    },
    "trigger_description": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "base_salary"
  ]
}