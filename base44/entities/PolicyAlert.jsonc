{
  "name": "PolicyAlert",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "alert_type": {
      "type": "string",
      "enum": [
        "deadline",
        "vote",
        "hearing",
        "status_change",
        "new_item",
        "funding",
        "urgent",
        "custom"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "info"
      ],
      "default": "medium"
    },
    "legislation_id": {
      "type": "string"
    },
    "official_id": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "is_dismissed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "alert_type"
  ]
}